# Copy to .env and fill in real values. Never commit .env.
# API details come from https://ads-docs.huydata.com

# --- Airflow ---
# Linux (this machine and the VM): set to the output of `id -u`, or logs fail with Permission denied.
AIRFLOW_UID=50000
# dev writes to dev datasets; only the VM uses prod.
AIRFLOW_ENV=dev
FERNET_KEY=
AIRFLOW__API__SECRET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
_AIRFLOW_WWW_USER_USERNAME=
_AIRFLOW_WWW_USER_PASSWORD=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=airflow

# --- Source BigQuery (read-only, instructor's project, never write here) ---
SOURCE_BQ_PROJECT=sound-machine-513207-u6
SOURCE_BQ_DATASET=candycrushsaga
SOURCE_BQ_CREDENTIALS_PATH=/opt/secrets/reader-sa.json

# --- Target BigQuery (personal project) ---
TARGET_BQ_PROJECT=
TARGET_BQ_LOCATION=
TARGET_BQ_DATASET_BRONZE=bronze
TARGET_BQ_DATASET_SILVER=silver
TARGET_BQ_DATASET_GOLD=gold
TARGET_BQ_CREDENTIALS_PATH=/opt/secrets/writer-sa.json

# --- Meta Ads ---
META_API_BASE_URL=https://graph.huydata.com/v21.0
META_ACCESS_TOKEN=

# --- TikTok Ads ---
TIKTOK_API_BASE_URL=https://business-api.huydata.com/open_api/v1.3
TIKTOK_ACCESS_TOKEN=

# --- Google Ads ---
GOOGLE_API_BASE_URL=https://googleads.huydata.com/v18
GOOGLE_ACCESS_TOKEN=
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_LOGIN_CUSTOMER_ID=9990001111

# --- Operations ---
ROLLING_WINDOW_DAYS=3
API_RATE_LIMIT_PER_MINUTE=60

# --- Hard and up: Grafana and alerts ---
GRAFANA_ADMIN_PASSWORD=
DISCORD_WEBHOOK_URL=
ALERT_EMAIL_TO=
BQ_MONTHLY_BUDGET_USD=
